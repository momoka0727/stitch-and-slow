{
  "name": "stitch-and-slow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=./wrangler.cloudflare.jsonc WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:cloudflare": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=./wrangler.cloudflare.jsonc WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy:cloudflare": "vp run build:cloudflare && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vp test --run",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "types:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types worker-configuration.d.ts --config wrangler.cloudflare.jsonc",
    "types:cloudflare:check": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types worker-configuration.d.ts --config wrangler.cloudflare.jsonc --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply DB --local --config wrangler.cloudflare.jsonc"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.4",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.115.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "22.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
